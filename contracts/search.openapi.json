{
  "openapi": "3.1.0",
  "info": {
    "title": "AgentForge discovery",
    "version": "0.1.0",
    "description": "Shared public search and browse contract for the website and native skill client."
  },
  "paths": {
    "/api/v1/catalog": {
      "get": {
        "summary": "Catalog",
        "operationId": "catalog_v1_catalog_get",
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100000,
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          },
          {
            "name": "harness",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "codex",
                    "claude-code",
                    "cursor",
                    "gemini",
                    "opencode",
                    "devin",
                    "portable"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Harness"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/search": {
      "post": {
        "summary": "Search",
        "operationId": "search_v1_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CapabilityProfile": {
        "properties": {
          "extractor_version": {
            "type": "string",
            "title": "Extractor Version",
            "default": "legacy"
          },
          "source_revision": {
            "type": "string",
            "title": "Source Revision",
            "default": ""
          },
          "outputs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 12,
            "title": "Outputs"
          },
          "use_when": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 12,
            "title": "Use When"
          },
          "avoid_when": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 12,
            "title": "Avoid When"
          },
          "tools": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 32,
            "title": "Tools"
          },
          "credentials": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 12,
            "title": "Credentials"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/FieldEvidence"
            },
            "type": "array",
            "maxItems": 24,
            "title": "Evidence"
          }
        },
        "type": "object",
        "title": "CapabilityProfile"
      },
      "CatalogResponse": {
        "properties": {
          "rows": {
            "items": {
              "$ref": "#/components/schemas/Skill"
            },
            "type": "array",
            "title": "Rows"
          },
          "skill_count": {
            "type": "integer",
            "title": "Skill Count"
          },
          "source_count": {
            "type": "integer",
            "title": "Source Count"
          },
          "categories": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Categories"
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          },
          "offset": {
            "type": "integer",
            "title": "Offset",
            "default": 0
          },
          "limit": {
            "type": "integer",
            "title": "Limit",
            "default": 50
          },
          "filtered_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Filtered Count"
          },
          "next_offset": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Offset"
          }
        },
        "type": "object",
        "required": [
          "rows",
          "skill_count",
          "source_count",
          "categories",
          "updated_at"
        ],
        "title": "CatalogResponse"
      },
      "FieldEvidence": {
        "properties": {
          "field": {
            "type": "string",
            "maxLength": 64,
            "title": "Field"
          },
          "quote": {
            "type": "string",
            "maxLength": 480,
            "title": "Quote"
          },
          "location": {
            "type": "string",
            "maxLength": 240,
            "title": "Location"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "status": {
            "type": "string",
            "enum": [
              "declared",
              "inferred"
            ],
            "title": "Status",
            "default": "declared"
          }
        },
        "type": "object",
        "required": [
          "field",
          "quote",
          "location",
          "source_url"
        ],
        "title": "FieldEvidence"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HarnessSupport": {
        "properties": {
          "harness": {
            "type": "string",
            "enum": [
              "codex",
              "claude-code",
              "cursor",
              "gemini",
              "opencode",
              "devin",
              "portable"
            ],
            "title": "Harness"
          },
          "status": {
            "type": "string",
            "enum": [
              "declared",
              "inferred",
              "tested",
              "incompatible",
              "unknown"
            ],
            "title": "Status"
          },
          "detail": {
            "type": "string",
            "maxLength": 480,
            "title": "Detail"
          },
          "evidence_url": {
            "type": "string",
            "title": "Evidence Url"
          },
          "checked_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checked At"
          },
          "harness_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Harness Version"
          }
        },
        "type": "object",
        "required": [
          "harness",
          "status",
          "detail",
          "evidence_url"
        ],
        "title": "HarnessSupport"
      },
      "JsonValue": {},
      "RecommendationFit": {
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 640,
            "title": "Reason"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/FieldEvidence"
            },
            "type": "array",
            "maxItems": 3,
            "title": "Evidence"
          },
          "missing_tools": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 32,
            "title": "Missing Tools"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 8,
            "title": "Notes"
          }
        },
        "type": "object",
        "required": [
          "reason"
        ],
        "title": "RecommendationFit"
      },
      "SearchConstraints": {
        "properties": {
          "available_tools": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "maxItems": 32
              },
              {
                "type": "null"
              }
            ],
            "title": "Available Tools"
          },
          "allow_setup": {
            "type": "boolean",
            "title": "Allow Setup",
            "default": true
          },
          "allow_credentials": {
            "type": "boolean",
            "title": "Allow Credentials",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "SearchConstraints"
      },
      "SearchMeta": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "matches",
              "no_match"
            ],
            "title": "Status"
          },
          "retrieval_mode": {
            "type": "string",
            "enum": [
              "hybrid",
              "lexical_only"
            ],
            "title": "Retrieval Mode"
          },
          "catalog_revision": {
            "type": "string",
            "title": "Catalog Revision"
          },
          "ranking_version": {
            "type": "string",
            "title": "Ranking Version",
            "default": "hybrid-v1"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "status",
          "retrieval_mode",
          "catalog_revision",
          "request_id"
        ],
        "title": "SearchMeta"
      },
      "SearchRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 2048,
            "minLength": 1,
            "title": "Query"
          },
          "harness": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "codex",
                  "claude-code",
                  "cursor",
                  "gemini",
                  "opencode",
                  "devin",
                  "portable"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Harness"
          },
          "limit": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 5
          },
          "constraints": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SearchConstraints"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query"
        ],
        "title": "SearchRequest"
      },
      "SearchResponse": {
        "properties": {
          "rows": {
            "items": {
              "$ref": "#/components/schemas/Skill"
            },
            "type": "array",
            "title": "Rows"
          },
          "meta": {
            "$ref": "#/components/schemas/SearchMeta"
          }
        },
        "type": "object",
        "required": [
          "rows",
          "meta"
        ],
        "title": "SearchResponse"
      },
      "Skill": {
        "properties": {
          "skill_id": {
            "type": "string",
            "title": "Skill Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "capabilities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Capabilities"
          },
          "example_prompts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Example Prompts"
          },
          "requirements": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Requirements"
          },
          "exclusions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Exclusions"
          },
          "compatibility": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Compatibility"
          },
          "license": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "License"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "adoption_status": {
            "type": "string",
            "enum": [
              "review_required",
              "metadata_only",
              "unavailable"
            ],
            "title": "Adoption Status"
          },
          "profile": {
            "$ref": "#/components/schemas/CapabilityProfile"
          },
          "harness_support": {
            "items": {
              "$ref": "#/components/schemas/HarnessSupport"
            },
            "type": "array",
            "maxItems": 12,
            "title": "Harness Support"
          },
          "fit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RecommendationFit"
              },
              {
                "type": "null"
              }
            ]
          },
          "author_metadata": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "type": "object",
            "maxProperties": 64,
            "title": "Author Metadata"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "skill_id",
          "name",
          "summary",
          "category",
          "capabilities",
          "example_prompts",
          "requirements",
          "exclusions",
          "compatibility",
          "license",
          "source",
          "adoption_status"
        ],
        "title": "Skill"
      },
      "Source": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          },
          "repository": {
            "type": "string",
            "title": "Repository"
          },
          "revision": {
            "type": "string",
            "title": "Revision"
          },
          "skill_path": {
            "type": "string",
            "title": "Skill Path"
          },
          "manifest_sha256": {
            "type": "string",
            "title": "Manifest Sha256"
          },
          "checked_at": {
            "type": "string",
            "title": "Checked At"
          },
          "files": {
            "items": {
              "$ref": "#/components/schemas/SourceFile"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Files"
          },
          "discovered_via": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Discovered Via"
          }
        },
        "type": "object",
        "required": [
          "url",
          "repository",
          "revision",
          "skill_path",
          "manifest_sha256",
          "checked_at"
        ],
        "title": "Source"
      },
      "SourceFile": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "git_blob_sha1": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$",
            "title": "Git Blob Sha1"
          }
        },
        "type": "object",
        "required": [
          "path",
          "git_blob_sha1"
        ],
        "title": "SourceFile"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
