  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Forest search and installation actions with a darker hover and visible focus.",
      "html": "<button class=\"ds-primary\">Find a skill<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 12h16m-6-6 6 6-6 6\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button>",
      "css": ".ds-primary{display:inline-flex;justify-content:center;align-items:center;gap:12px;background:var(--accent,#244638);border:1px solid var(--accent,#244638);color:white;border-radius:8px;padding:12px 16px;font-family:var(--font-geist-sans,\"Geist Sans\"),sans-serif;font-size:16px;font-weight:550;line-height:24px;white-space:nowrap;cursor:pointer;transition:background-color .3s var(--ease,cubic-bezier(0.22,1,0.36,1)),border-color .3s var(--ease,cubic-bezier(0.22,1,0.36,1)),transform .3s var(--ease,cubic-bezier(0.22,1,0.36,1));}.ds-primary:hover{background:var(--accent-hover,#183a2c);border-color:var(--accent-hover,#183a2c);}.ds-primary:focus-visible{outline:3px solid var(--accent,#244638);outline-offset:4px;}.ds-primary:active{transform:translateY(1px);}.ds-primary:disabled{opacity:.65;cursor:wait;}@media(prefers-reduced-motion:reduce){.ds-primary{transition-duration:.01ms;}}"
    },
    {
      "name": "Outlined installation link",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Secondary navigation action.",
      "html": "<a class=\"ds-outline\" href=\"#install\">Install AgentForge</a>",
      "css": ".ds-outline{display:inline-flex;align-items:center;min-height:44px;padding:8px 12px;border:1px solid #cbd2c3;border-radius:8px;background:transparent;color:var(--ink,#243c31);font-family:var(--font-geist-sans,\"Geist Sans\"),sans-serif;font-size:14px;font-weight:500;text-decoration:none;transition:background-color .3s var(--ease,cubic-bezier(0.22,1,0.36,1)),border-color .3s var(--ease,cubic-bezier(0.22,1,0.36,1)),transform .3s var(--ease,cubic-bezier(0.22,1,0.36,1));}.ds-outline:hover{background:var(--white,#fffdf8);border-color:var(--muted,#586355);}.ds-outline:focus-visible{outline:3px solid var(--accent,#244638);outline-offset:4px;}.ds-outline:active{transform:translateY(1px);}@media(prefers-reduced-motion:reduce){.ds-outline{transition-duration:.01ms;}}"
    },
    {
      "name": "Task search",
      "kind": "input",
      "refersTo": "search",
      "description": "Familiar text field and separate forest action. The mobile action keeps its accessible name.",
      "html": "<form class=\"ds-search\" role=\"search\"><svg class=\"ds-search-icon\" width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"m15.5 15.5 5 5\" stroke=\"currentColor\" stroke-width=\"1.5\"/></svg><input aria-label=\"What are you trying to do?\" placeholder=\"What are you trying to do?\"/><button type=\"button\" class=\"ds-primary ds-search-button\" aria-label=\"Find a skill\"><span>Find a skill</span><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 12h16m-6-6 6 6-6 6\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button></form>",
      "css": ".ds-primary{display:inline-flex;justify-content:center;align-items:center;gap:12px;background:var(--accent,#244638);border:1px solid var(--accent,#244638);color:white;border-radius:8px;padding:12px 16px;font-family:var(--font-geist-sans,\"Geist Sans\"),sans-serif;font-size:16px;font-weight:550;line-height:24px;white-space:nowrap;cursor:pointer;transition:background-color .3s var(--ease,cubic-bezier(0.22,1,0.36,1)),border-color .3s var(--ease,cubic-bezier(0.22,1,0.36,1)),transform .3s var(--ease,cubic-bezier(0.22,1,0.36,1));}.ds-primary:hover{background:var(--accent-hover,#183a2c);border-color:var(--accent-hover,#183a2c);}.ds-primary:focus-visible{outline:3px solid var(--accent,#244638);outline-offset:4px;}.ds-primary:active{transform:translateY(1px);}.ds-primary:disabled{opacity:.65;cursor:wait;}@media(prefers-reduced-motion:reduce){.ds-primary{transition-duration:.01ms;}}.ds-search{display:flex;align-items:center;gap:16px;padding:12px 12px 12px 24px;background:var(--white,#fffdf8);border:1px solid #c8c5b3;border-radius:16px;transition:border-color .3s var(--ease,cubic-bezier(0.22,1,0.36,1));}.ds-search:focus-within{border-color:var(--accent,#244638);}.ds-search-icon{flex:none;color:#66725e;}.ds-search input{flex:1;min-width:0;background:none;border:0;outline:0;padding:12px 0;font-family:var(--font-geist-sans,\"Geist Sans\"),sans-serif;font-size:18px;line-height:28px;color:var(--ink,#243c31);caret-color:var(--accent,#244638);}.ds-search input::placeholder{color:#687360;}.ds-search-button{min-width:148px;}@media(max-width:600px){.ds-search{gap:8px;padding:8px 8px 8px 16px;}.ds-search input{font-size:16px;line-height:24px;padding:8px 0;}.ds-search-icon{width:18px;}.ds-search-button{min-width:48px;padding:12px;}.ds-search-button span{display:none;}}@media(prefers-reduced-motion:reduce){.ds-search{transition-duration:.01ms;}}"
    },
    {
      "name": "Category filter",
      "kind": "chip",
      "refersTo": "category",
      "description": "Quiet filter with a 44px minimum target.",
      "html": "<button class=\"ds-category\">Writing</button>",
      "css": ".ds-category{min-height:44px;white-space:nowrap;padding:8px 12px;font-family:var(--font-geist-sans,\"Geist Sans\"),sans-serif;font-size:14px;border:0;border-radius:8px;background:none;color:var(--muted,#586355);cursor:pointer;transition:color .3s var(--ease,cubic-bezier(0.22,1,0.36,1)),background-color .3s var(--ease,cubic-bezier(0.22,1,0.36,1)),transform .3s var(--ease,cubic-bezier(0.22,1,0.36,1));}.ds-category:hover{background:#e9ede3;color:var(--ink,#243c31);}.ds-category:focus-visible{outline:3px solid var(--accent,#244638);outline-offset:4px;}.ds-category:active{transform:translateY(1px);}.ds-category-active,.ds-category-active:hover{background:var(--ink,#243c31);color:white;}@media(prefers-reduced-motion:reduce){.ds-category{transition-duration:.01ms;}}"
    },
    {
      "name": "Selected category",
      "kind": "chip",
      "refersTo": "category-active",
      "description": "Forest-ink fill distinguishes the selected category.",
      "html": "<button class=\"ds-category ds-category-active\" aria-pressed=\"true\">All skills</button>",
      "css": ".ds-category{min-height:44px;white-space:nowrap;padding:8px 12px;font-family:var(--font-geist-sans,\"Geist Sans\"),sans-serif;font-size:14px;border:0;border-radius:8px;background:none;color:var(--muted,#586355);cursor:pointer;transition:color .3s var(--ease,cubic-bezier(0.22,1,0.36,1)),background-color .3s var(--ease,cubic-bezier(0.22,1,0.36,1)),transform .3s var(--ease,cubic-bezier(0.22,1,0.36,1));}.ds-category:hover{background:#e9ede3;color:var(--ink,#243c31);}.ds-category:focus-visible{outline:3px solid var(--accent,#244638);outline-offset:4px;}.ds-category:active{transform:translateY(1px);}.ds-category-active,.ds-category-active:hover{background:var(--ink,#243c31);color:white;}@media(prefers-reduced-motion:reduce){.ds-category{transition-duration:.01ms;}}"
    },
    {
      "name": "Catalog row",
      "kind": "card",
      "refersTo": "catalog-row",
      "description": "Flat catalog entry with a category badge, source line, description, and disclosure action.",
      "html": "<article class=\"ds-row\"><div class=\"ds-badge\" aria-hidden=\"true\">W</div><div><h3 class=\"ds-row-title\"><button>Skill name</button></h3><p class=\"ds-row-publisher\">Publisher</p><p class=\"ds-row-summary\">The skill description appears here.</p></div><button class=\"ds-row-toggle\" aria-label=\"Show skill details\" aria-expanded=\"false\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\" stroke=\"currentColor\" stroke-width=\"1.5\"/></svg></button></article>",
      "css": ".ds-row{display:grid;grid-template-columns:40px minmax(0,1fr) 44px;column-gap:24px;padding:24px 8px;border-bottom:1px solid var(--line,#dad6c7);color:var(--ink,#243c31);font-family:var(--font-geist-sans,\"Geist Sans\"),sans-serif;transition:background .2s var(--ease,cubic-bezier(0.22,1,0.36,1));}.ds-row:hover{background:var(--surface-hover,#efede3);}.ds-row.ds-expanded{background:var(--white,#fffdf8);}.ds-badge{width:40px;height:40px;display:flex;align-items:center;justify-content:center;background:#f1e9dd;color:#8b603a;border-radius:12px;font-size:16px;font-weight:550;}.ds-row-title{margin:0;font-size:18px;line-height:28px;}.ds-row-title button{padding:0;background:none;border:0;color:inherit;font:inherit;font-weight:550;min-height:44px;margin-top:-8px;margin-bottom:-8px;text-align:left;cursor:pointer;}.ds-row-title button:hover{color:var(--accent,#244638);}.ds-row-publisher{margin:0;color:var(--muted,#586355);font-size:12px;line-height:18px;}.ds-row-summary{margin:4px 0 0;color:var(--muted,#586355);font-size:14px;line-height:24px;}.ds-row-toggle{display:flex;align-items:center;justify-content:center;width:44px;height:44px;margin-top:-8px;border:0;border-radius:8px;background:none;color:#64715d;cursor:pointer;}.ds-row-toggle:hover{background:#e5ebdc;color:var(--accent,#244638);}.ds-row button:focus-visible{outline:3px solid var(--accent,#244638);outline-offset:4px;}.ds-row button:active{transform:translateY(1px);}@media(max-width:600px){.ds-row{grid-template-columns:32px minmax(0,1fr) 44px;column-gap:12px;padding:24px 0;}.ds-badge{width:32px;height:32px;border-radius:8px;font-size:14px;}.ds-row-title{font-size:16px;line-height:24px;}}@media(prefers-reduced-motion:reduce){.ds-row{transition-duration:.01ms;}}"
    },
    {
      "name": "Installation panel",
      "kind": "card",
      "refersTo": "install-panel",
      "description": "A bordered reading surface for the setup prompt and copy action.",
      "html": "<div class=\"ds-install\"><div class=\"ds-install-head\">Give this to your agent</div><p class=\"ds-install-prompt\">Install AgentForge and look for useful skills when I bring you a new task. Explain what a skill makes possible before offering to use it.</p><button type=\"button\" class=\"ds-primary ds-install-action\">Copy setup prompt</button></div>",
      "css": ".ds-primary{display:inline-flex;justify-content:center;align-items:center;gap:12px;background:var(--accent,#244638);border:1px solid var(--accent,#244638);color:white;border-radius:8px;padding:12px 16px;font-family:var(--font-geist-sans,\"Geist Sans\"),sans-serif;font-size:16px;font-weight:550;line-height:24px;white-space:nowrap;cursor:pointer;transition:background-color .3s var(--ease,cubic-bezier(0.22,1,0.36,1)),border-color .3s var(--ease,cubic-bezier(0.22,1,0.36,1)),transform .3s var(--ease,cubic-bezier(0.22,1,0.36,1));}.ds-primary:hover{background:var(--accent-hover,#183a2c);border-color:var(--accent-hover,#183a2c);}.ds-primary:focus-visible{outline:3px solid var(--accent,#244638);outline-offset:4px;}.ds-primary:active{transform:translateY(1px);}.ds-primary:disabled{opacity:.65;cursor:wait;}@media(prefers-reduced-motion:reduce){.ds-primary{transition-duration:.01ms;}}.ds-install{padding:32px;background:var(--white,#fffdf8);border:1px solid #d6decb;border-radius:16px;color:var(--ink,#243c31);font-family:var(--font-geist-sans,\"Geist Sans\"),sans-serif;}.ds-install-head{font-size:14px;font-weight:500;line-height:21px;margin-bottom:24px;}.ds-install-prompt{margin:0;font-size:18px;line-height:28px;letter-spacing:-.01em;}.ds-install-action{width:100%;margin-top:24px;}@media(max-width:900px){.ds-install{padding:24px;}}"
    },
    {
      "name": "Header navigation",
      "kind": "nav",
      "description": "Literary wordmark beside functional Geist navigation and outlined installation.",
      "html": "<header class=\"ds-header\"><div class=\"ds-nav-wrap\"><a class=\"ds-brand\" href=\"#\" aria-label=\"AgentForge home\"><svg viewBox=\"0 0 40 40\" fill=\"none\" aria-hidden=\"true\"><circle cx=\"20\" cy=\"20\" r=\"18\" stroke=\"currentColor\" stroke-width=\"1.5\"/><circle cx=\"20\" cy=\"20\" r=\"14.5\" stroke=\"currentColor\" stroke-width=\"0.6\"/><path d=\"M10 17h20l-4 5h-4v5h5v2H13v-2h5v-5h-3l-5-5Z\" fill=\"currentColor\"/><path d=\"m20 8 2 3-2 3-2-3 2-3Z\" fill=\"var(--gold, #92713d)\"/></svg><span>agentforge</span></a><nav class=\"ds-nav\" aria-label=\"Main\"><a class=\"ds-explore\" href=\"#catalog\">Explore skills</a><a class=\"ds-outline\" href=\"#install\">Install</a></nav></div></header>",
      "css": ".ds-outline{display:inline-flex;align-items:center;min-height:44px;padding:8px 12px;border:1px solid #cbd2c3;border-radius:8px;background:transparent;color:var(--ink,#243c31);font-family:var(--font-geist-sans,\"Geist Sans\"),sans-serif;font-size:14px;font-weight:500;text-decoration:none;transition:background-color .3s var(--ease,cubic-bezier(0.22,1,0.36,1)),border-color .3s var(--ease,cubic-bezier(0.22,1,0.36,1)),transform .3s var(--ease,cubic-bezier(0.22,1,0.36,1));}.ds-outline:hover{background:var(--white,#fffdf8);border-color:var(--muted,#586355);}.ds-outline:focus-visible{outline:3px solid var(--accent,#244638);outline-offset:4px;}.ds-outline:active{transform:translateY(1px);}@media(prefers-reduced-motion:reduce){.ds-outline{transition-duration:.01ms;}}.ds-header{background:var(--paper,#f8f5ed);border-bottom:1px solid var(--line,#dad6c7);color:var(--ink,#243c31);}.ds-nav-wrap{max-width:1440px;margin:auto;padding:24px 48px;display:flex;justify-content:space-between;align-items:center;gap:24px;}.ds-brand{display:inline-flex;gap:12px;align-items:center;font-family:var(--font-literary,\"Cormorant Garamond\"),Georgia,serif;font-size:24px;line-height:32px;font-weight:600;letter-spacing:-.02em;color:inherit;text-decoration:none;}.ds-brand svg{width:32px;height:32px;color:var(--accent,#244638);}.ds-nav{display:flex;align-items:center;gap:32px;font-family:var(--font-geist-sans,\"Geist Sans\"),sans-serif;font-size:14px;font-weight:500;}.ds-nav a{display:inline-flex;align-items:center;min-height:44px;color:inherit;text-decoration:none;}.ds-nav a:hover{color:var(--accent,#244638);}.ds-brand:focus-visible,.ds-nav a:focus-visible{outline:3px solid var(--accent,#244638);outline-offset:4px;}@media(max-width:900px){.ds-nav-wrap{padding:24px 32px;}.ds-nav{gap:24px;}}@media(max-width:600px){.ds-nav-wrap{padding:16px 24px;}.ds-brand{font-size:20px;line-height:28px;gap:8px;}.ds-brand svg{width:28px;height:28px;}.ds-nav{gap:12px;}.ds-explore{display:none!important;}}"
