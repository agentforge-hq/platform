  "narrative": {
    "northStar": "The Literary Field Guide",
    "overview": "AgentForge pairs an inscription-like title with a practical reference catalog.\nWarm ivory, forest green, restrained gold, and a literary serif carry the\napproved Tolkien-inspired character. The search field, filters, catalog data,\nand installation controls retain familiar interface forms.\n\nThe original two-ring forge emblem repeats in the navigation, hero, footer,\nand favicon. The full founder tagline remains intact. `src/lib/brand.ts` owns\nthe copy shared by the hero and social metadata.",
    "keyCharacteristics": [
      "A literary title and verse above a clearly labeled search field.",
      "Warm paper backgrounds, fine separators, and flat catalog rows.",
      "Forest actions and limited gold ornament.",
      "Original ring-and-forge geometry repeated at different sizes.",
      "Geist for controls and data, with visible keyboard focus."
    ],
    "rules": [
      {
        "name": "The Forest Action Rule",
        "body": "Forest identifies actions and focus. Gold stays with the emblem, ornament, verse rule, and text selection.",
        "section": "colors"
      },
      {
        "name": "The Inscription and Interface Rule",
        "body": "Cormorant carries the tagline, wordmark, installation heading, statement, and legal title. Geist carries search, navigation, catalog information, and controls. Mono stays with code.",
        "section": "typography"
      },
      {
        "name": "The One Emblem Rule",
        "body": "Reuse the two-ring anvil and spark geometry. The hero uses gold for the whole mark. Navigation, footer, and favicon use forest with a gold spark.",
        "section": "shapes"
      }
    ],
    "dos": [
      "**Do** preserve the complete tagline from `src/lib/brand.ts` in the hero and shared metadata.",
      "**Do** use forest for primary controls and gold for the established ornament.",
      "**Do** preserve the familiar search field, clear status messages, and visible focus treatment.",
      "**Do** reuse the original emblem geometry in the header, hero, footer, and favicon.",
      "**Do** keep literary fonts self-hosted and retain the bundled font license.",
      "**Do** preserve the flat catalog rows and full-width expanded details on mobile."
    ],
    "donts": [
      "**Don't** shorten the founder tagline or clip it to preserve the desktop split.",
      "**Don't** use the literary serif for catalog metadata, search controls, or commands.",
      "**Don't** replace functional icons with ornamental lettering or ring motifs.",
      "**Don't** introduce decorative gradients, stock hero imagery, or a terminal costume.",
      "**Don't** turn local pastel category colors into the action palette."
    ]
  }
